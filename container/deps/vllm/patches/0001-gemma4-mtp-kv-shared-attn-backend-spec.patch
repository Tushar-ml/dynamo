From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dynamo <dynamo@nvidia.com>
Date: Sat, 23 May 2026 00:00:00 +0000
Subject: [PATCH] Fix KV-shared draft layer attn backend spec lookup for Gemma4 MTP

When Gemma4 MTP draft layers share KV cache with the target model, they are
added to a target KV cache group but omitted from UniformTypeKVCacheSpecs.
Resolve the shared target layer's spec instead of raising KeyError during
initialize_attn_backend / CUDA graph profiling.

Regenerated against VLLM_REF c301d749c1267fe65a80a0c6e84d7fdac4c5dd4e: the
previous hunk targeted line 6722 with trailing context that does not exist at
this ref, so `git apply` (which does not fuzz) rejected it and the image build
failed.
---
 vllm/v1/worker/gpu_model_runner.py | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/vllm/v1/worker/gpu_model_runner.py b/vllm/v1/worker/gpu_model_runner.py
--- a/vllm/v1/worker/gpu_model_runner.py
+++ b/vllm/v1/worker/gpu_model_runner.py
@@ -6496,7 +6496,29 @@
                 full_cls_name = attn_backend.full_cls_name()
                 layer_kv_cache_spec = kv_cache_group_spec.kv_cache_spec
                 if isinstance(layer_kv_cache_spec, UniformTypeKVCacheSpecs):
-                    layer_kv_cache_spec = layer_kv_cache_spec.kv_cache_specs[layer_name]
+                    if layer_name in layer_kv_cache_spec.kv_cache_specs:
+                        layer_kv_cache_spec = layer_kv_cache_spec.kv_cache_specs[
+                            layer_name
+                        ]
+                    else:
+                        # Gemma4 MTP draft layers that share KV cache with the
+                        # target are added to a target KV cache group but omitted
+                        # from UniformTypeKVCacheSpecs. Resolve the shared target
+                        # layer's spec instead of raising KeyError during
+                        # initialize_attn_backend / CUDA graph profiling.
+                        tgt = getattr(
+                            layers[layer_name],
+                            "kv_sharing_target_layer_name",
+                            None,
+                        )
+                        if tgt and tgt in layer_kv_cache_spec.kv_cache_specs:
+                            layer_kv_cache_spec = layer_kv_cache_spec.kv_cache_specs[
+                                tgt
+                            ]
+                        else:
+                            layer_kv_cache_spec = layer_kv_cache_spec.kv_cache_specs[
+                                layer_name
+                            ]
                 key = (full_cls_name, layer_kv_cache_spec)
                 attn_backends[key] = AttentionGroupKey(
                     attn_backend, layer_kv_cache_spec
